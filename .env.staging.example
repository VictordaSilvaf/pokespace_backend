# Copie para .env.staging e preencha TODOS os valores obrigatórios.
# Nunca commite .env.staging. Use senhas/secrets distintos de produção.
#
#   cp .env.staging.example .env.staging

# --- API ---
API_PORT=3001
DEFAULT_LOCALE=pt-BR
CHARACTER_MAX_PER_ACCOUNT=5

# NestJS Observe (opcional)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# --- Auth (OBRIGATÓRIO: troque o secret; diferente de prod) ---
AUTH_TOKEN_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_STAGING
AUTH_TOKEN_TTL=900
AUTH_REFRESH_TOKEN_TTL=604800
AUTH_REFRESH_COOKIE=false
AUTH_RESET_TOKEN_TTL=900
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_TTL=900
AUTH_VERIFY_EMAIL_TTL=86400
AUTH_REQUIRE_EMAIL_VERIFIED=true
AUTH_PHONE_OTP_TTL=300
AUTH_TEMP_TOKEN_TTL=300
AUTH_2FA_ISSUER=PokeNaut-Staging
AUTH_EXPOSE_RESET_TOKEN=false
AUTH_EXPOSE_VERIFY_EMAIL_TOKEN=false
AUTH_EXPOSE_PHONE_OTP=false

# --- Postgres (obrigatório; DB isolado via volume staging) ---
POSTGRES_USER=pokespace
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_STAGING
POSTGRES_DB=pokespace_staging

# --- Redis (obrigatório) ---
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_STAGING

# --- RabbitMQ (obrigatório) ---
RABBITMQ_USER=pokespace
RABBITMQ_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_STAGING
RABBITMQ_VHOST=/

# --- Kafka ---
# CLUSTER_ID distinto do de produção
KAFKA_CLUSTER_ID=U3RhZ2luZ0thZmthQ2x1c3Rlcg
KAFKA_LOG_RETENTION_HOURS=72

# --- DynamoDB ---
AWS_REGION=sa-east-1
DYNAMODB_DRIVER=dynamodb
DYNAMODB_TABLE_IDEMPOTENCY=game-staging-idempotency

# --- SMTP ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply-staging@victorsf.com
