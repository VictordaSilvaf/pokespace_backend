PORT=3000

# Locale fallback for emails / non-HTTP contexts (en | pt-BR | es)
DEFAULT_LOCALE=en

# Characters
CHARACTER_MAX_PER_ACCOUNT=5

# NestJS Observe (https://observe.nestjs.com)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# Auth (JWT)
AUTH_TOKEN_SECRET=change-me-in-dev
AUTH_TOKEN_TTL=900
AUTH_REFRESH_TOKEN_TTL=604800
AUTH_REFRESH_COOKIE=false
AUTH_RESET_TOKEN_TTL=900
AUTH_EXPOSE_RESET_TOKEN=false
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_TTL=900
AUTH_VERIFY_EMAIL_TTL=86400
AUTH_EXPOSE_VERIFY_EMAIL_TOKEN=false
AUTH_REQUIRE_EMAIL_VERIFIED=false
AUTH_PHONE_OTP_TTL=300
AUTH_EXPOSE_PHONE_OTP=false
AUTH_TEMP_TOKEN_TTL=300
AUTH_2FA_ISSUER=PokeSpace

# Persistence: omit or set to "postgres" (default). Use "memory" for tests.
# USER_REPOSITORY_DRIVER=postgres

# Postgres
POSTGRES_USER=pokespace
POSTGRES_PASSWORD=pokespace
POSTGRES_DB=pokespace
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pokespace:pokespace@localhost:5432/pokespace

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# REDIS_DRIVER=memory
# REDIS_KEY_PREFIX=pokespace:

# Mailpit (local email)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_UI_URL=http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@poke.space
# SMTP_USER=
# SMTP_PASS=

# RabbitMQ
RABBITMQ_USER=pokespace
RABBITMQ_PASSWORD=pokespace
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://pokespace:pokespace@localhost:5672

# Kafka (host → localhost:9092 | containers → kafka:29092)
KAFKA_PORT=9092
KAFKA_BROKERS=localhost:9092

# DynamoDB (specialized: idempotency, player history — not a second Postgres)
# Driver: omit or "memory" for tests/local without AWS; "dynamodb" for LocalStack/AWS.
# DYNAMODB_DRIVER=memory
AWS_REGION=sa-east-1
# LocalStack (docker compose service `localstack`):
# DYNAMODB_DRIVER=dynamodb
# DYNAMODB_ENDPOINT=http://localhost:4566
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
DYNAMODB_TABLE_IDEMPOTENCY=game-dev-idempotency
# DYNAMODB_TABLE_PLAYER_HISTORY=game-dev-player-history
