PORT=3000

# NestJS Observe (https://observe.nestjs.com)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# Auth (HMAC token bootstrap)
AUTH_TOKEN_SECRET=change-me-in-dev
AUTH_TOKEN_TTL=3600
AUTH_RESET_TOKEN_TTL=900
AUTH_EXPOSE_RESET_TOKEN=false

# Postgres
POSTGRES_USER=pokespace
POSTGRES_PASSWORD=pokespace
POSTGRES_DB=pokespace
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pokespace:pokespace@localhost:5432/pokespace

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_USER=pokespace
RABBITMQ_PASSWORD=pokespace
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://pokespace:pokespace@localhost:5672

# Kafka (host → localhost:9092 | containers → kafka:29092)
KAFKA_PORT=9092
KAFKA_BROKERS=localhost:9092
