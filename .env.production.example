# Copie para .env.production e preencha TODOS os valores obrigatórios.
# Nunca commite .env.production.
#
#   cp .env.production.example .env.production

# --- API ---
API_PORT=3000
DEFAULT_LOCALE=pt-BR
CHARACTER_MAX_PER_ACCOUNT=5

# NestJS Observe (opcional em self-host; deixe vazio se não usar)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# --- Auth (OBRIGATÓRIO: troque o secret) ---
AUTH_TOKEN_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
AUTH_TOKEN_TTL=900
AUTH_REFRESH_TOKEN_TTL=604800
AUTH_REFRESH_COOKIE=false
AUTH_RESET_TOKEN_TTL=900
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_TTL=900
AUTH_VERIFY_EMAIL_TTL=86400
AUTH_REQUIRE_EMAIL_VERIFIED=true
AUTH_PHONE_OTP_TTL=300
AUTH_TEMP_TOKEN_TTL=300
AUTH_2FA_ISSUER=PokeSpace
AUTH_EXPOSE_RESET_TOKEN=false
AUTH_EXPOSE_VERIFY_EMAIL_TOKEN=false
AUTH_EXPOSE_PHONE_OTP=false

# --- Postgres (obrigatório) ---
POSTGRES_USER=pokespace
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=pokespace

# --- Redis (obrigatório) ---
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# --- RabbitMQ (obrigatório) ---
RABBITMQ_USER=pokespace
RABBITMQ_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
RABBITMQ_VHOST=/

# --- Kafka ---
# Gere um UUID base64-ish estável (ex.: openssl rand -base64 16 | tr '+/' '-_')
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_LOG_RETENTION_HOURS=168

# --- SMTP real (obrigatório em produção; sem Mailpit) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@your-domain.com
